# Copy this file to `.env` only when you want to change a default.
#   cp .env.example .env
#
# `.env` is listed in .gitignore. A Sepolia URL often contains a private API key.
# Do not commit `.env`, and do not paste that URL into chat or into a screenshot.

# Which network the wallet talks to.
#   anvil   = a pretend Ethereum on your computer (the default, and the right place to start)
#   sepolia = Ethereum's public test network. The coins there are play money.
# This wallet refuses any other name, including mainnet, so a practice session
# cannot send a transaction to the network where ETH has real value.
CHAIN=anvil

# Anvil listens here unless you started it with a different --port.
ANVIL_RPC_URL=http://127.0.0.1:8545

# Used only when CHAIN=sepolia. Leave it empty until you have a URL from a
# provider such as Alchemy or Infura. This project does not ship with an API key.
# SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-key-here
SEPOLIA_RPC_URL=

# Optional. If you already deployed LearningVault, paste the address here.
# `npm run wallet -- contract deploy` also remembers the address in
# `.wallet/vault.json`. An address set here wins over that file.
VAULT_ADDRESS=

# Optional. PropertyShare address from the property-token lesson.
# `npm run wallet -- property deploy` also remembers it in `.wallet/property.json`.
# An address set here wins over that file. The address is not a secret.
PROPERTY_ADDRESS=
