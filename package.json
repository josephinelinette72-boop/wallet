{
  "name": "learning-wallet",
  "private": true,
  "version": "0.1.0",
  "description": "A heavily commented Ethereum wallet for learning self-custody. Not for real funds.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "wallet": "tsx src/cli.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "lint": "eslint src test ui",
    "ui": "vite --config ui/vite.config.ts --host 0.0.0.0 --port 5173",
    "ui:build": "vite build --config ui/vite.config.ts",
    "ui:preview": "vite preview --config ui/vite.config.ts --host 0.0.0.0 --port 5173",
    "contracts:build": "forge build --root foundry",
    "contracts:test": "forge test --root foundry -vv",
    "property:build": "forge build --root property-token",
    "property:test": "forge test --root property-token -vv"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^1.9.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip32": "^1.7.0",
    "@scure/bip39": "^1.5.4",
    "dotenv": "^16.6.1",
    "lucide-react": "^1.77.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.38.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
